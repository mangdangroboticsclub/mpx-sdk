    "set_studio_mode": {
      "status": "withheld",
      "why": "Servo Studio is the human-in-the-loop calibration tool. A skill silently putting the robot into Studio mode would take the bus away from a person who is watching a joint move. Use the robot's web UI."
    },
    "studio_mode": {
