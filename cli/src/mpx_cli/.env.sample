# mpx-cli configuration — copy to .env and edit.
#
# Everything here is OPTIONAL. The CLI works on a fresh clone with no .env at
# all; this file only exists to override defaults.
#
# Loaded by src/mpx_cli/__init__.py from ./.env and from the package
# directory. A real environment variable always wins over this file.

# ── The robot ────────────────────────────────────────────────────
# 192.168.2.1 is the robot's own hotspot. If the robot is joined to your
# Wi-Fi instead, use the address it has there — the robot's log prints it as
# `sta=connected ... ip=<address>`.
MPX_HOST=192.168.2.1
MPX_PORT=80

# ── The marketplace gateway ──────────────────────────────────────
# LEAVE THIS COMMENTED OUT unless you are running a gateway yourself.
#
# The default is already the real marketplace, so signup, login, publish and
# install work with no configuration. This file used to ship the line
# uncommented and pointing at localhost, which meant copying the sample —
# the one thing the sample asks you to do — broke every marketplace command
# with
#     [Errno 111] Connection refused
# and made it look like the marketplace was down rather than like a setting
# nobody meant to change.
#
# MPX_GATEWAY_URL=http://localhost:8080
